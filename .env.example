# Local settings, for `npm run dev` and for the notes commands. Copy to
# .env.local, which is git-ignored:
#
#   cp .env.example .env.local
#
# Vite reads the VITE_* variable out of it when the dev server starts, and
# scripts/notes.mjs reads the rest — so this is the whole of local setup. A
# shell variable overrides anything written here, and `--bucket` overrides both.

# The public R2 bucket this build reads the published notes out of — one per
# environment. CI sets it per environment from the repository variables
# DEV_NOTES_BASE_URL / PROD_NOTES_BASE_URL (see .github/workflows/deploy.yml);
# locally, point it at the dev bucket.
#
# A build without it still runs: /notes simply says it was not told where the
# notes are.
VITE_NOTES_BASE_URL=https://pub-0123456789abcdef0123456789abcdef.r2.dev

# The account's R2 endpoint, which the notes commands publish and pull through,
# and the AWS profile holding the R2 token they do it with. The endpoint is not
# the same thing as the public URL above: this one speaks the S3 API. Written
# here, the two together mean a bare `npm run notes:pull` works in any shell.
# See docs/notes-r2-storage.md for where both come from.
FRETBOOK_R2_ENDPOINT=https://0123456789abcdef0123456789abcdef.r2.cloudflarestorage.com
AWS_PROFILE=r2

# Which bucket those commands act on. Leave it out and they use
# fretbook-notes-dev, which is what local work wants; set it, or pass --bucket,
# to reach production on purpose.
# FRETBOOK_NOTES_BUCKET=fretbook-notes-prod
