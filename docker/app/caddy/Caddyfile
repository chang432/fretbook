# Single site on :80. This is the *inner* proxy, one per environment: TLS and
# hostname routing belong to the VPS's edge proxy (docker/edge/), which
# terminates HTTPS and forwards here over loopback. Locally there is no edge
# and this is reached directly on http://localhost:8080.
{
	admin off
	auto_https off
}

:80 {
	encode gzip zstd

	# Everything under /api goes to the gunicorn/Flask container. `backend` is
	# the compose service name, resolved on the shared network.
	handle /api/* {
		reverse_proxy backend:8000
	}

	# The published notes, served as the files they are. This sits in front of
	# the catch-all below because try_files would answer a name with no file
	# behind it with index.html and a 200 — which the app would then have to
	# tell apart from a real note. Here a missing one is a plain 404, the same
	# as it is under `vite dev`.
	handle /notes/*.json {
		root * /srv
		file_server
	}

	# Static build output. try_files sends unknown paths to index.html so the
	# SPA keeps working on a deep link / refresh — including /notes and
	# /notes/<name>, which are addresses in the app rather than files.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
