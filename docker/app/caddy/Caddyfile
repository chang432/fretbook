# Single site on :80. This is the *inner* proxy, one per environment: TLS and
# hostname routing belong to the VPS's edge proxy (docker/edge/), which
# terminates HTTPS and forwards here over loopback. Locally there is no edge
# and this is reached directly on http://localhost:8080.
{
	admin off
	auto_https off
}

:80 {
	encode gzip zstd

	# Everything under /api goes to the gunicorn/Flask container. `backend` is
	# the compose service name, resolved on the shared network. The published
	# notes are among those routes — /api/notes and /api/notes/<name> — since
	# the bucket they live in is private and only the backend holds a token for
	# it. That is also why no CORS rule is involved: same origin.
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Static build output. try_files sends unknown paths to index.html so the
	# SPA keeps working on a deep link / refresh — including /notes and
	# /notes/<name>, which are addresses in the app rather than files. The
	# notes themselves are not here at all: they are fetched from /api/notes,
	# handled above, and the handle blocks do not overlap — /api/notes is the
	# data, /notes is the page that asks for it.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
