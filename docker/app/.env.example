# Settings for the local app stack — `docker compose up` in this directory,
# which is what `npm run stack` and `npm run deploy:local` run for you.
#
#   cp docker/app/.env.example docker/app/.env
#
# `.env` is git-ignored and this file is not, so nothing real goes in here.
# The stack scripts copy it across the first time and then refuse to start
# until the placeholder below is gone: a stack with no bucket behind it comes
# up exactly as happily as one with, and the only sign is a silently empty
# /notes.
#
# Compose interpolates these into the backend's environment — see
# docker-compose.yml, which is the list of what the backend actually reads. A
# shell variable beats the file, for compose and for the check in
# scripts/lib/stack.sh alike, so a credential need not go on disk at all:
#
#   eval "$(aws configure export-credentials --profile r2 --format env)"
#
# This is the laptop's half of what the VPS gets written into
# /opt/fretbook-<env>-deploy.env by .github/workflows/deploy.yml.

# Which bucket this stack serves, and publishes into. Local work is dev work,
# so that is the default; production is named on purpose or not at all.
FRETBOOK_NOTES_BUCKET=fretbook-notes-dev

# The account's R2 endpoint — the same one `.env.local` carries for the notes
# commands. docs/notes-r2-storage.md is where it comes from.
FRETBOOK_R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com

# The R2 token the backend signs with. **Object Read & Write**: it serves the
# published notes and writes the ones published from the editor, so the `r2`
# profile's own token does the job. Leave both empty to export them instead —
# the check above counts a shell variable as set.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# What the Update and Delete buttons on a published note ask for, and the only
# way to write over a note or take one down — see
# docs/notes-upload-from-app.md. Optional, and nothing checks for it: left
# empty, those buttons answer 503 and the rest of the stack is unaffected, so
# this is how a stack opts into being editable at all.
FRETBOOK_PUBLISH_PASSWORD=
